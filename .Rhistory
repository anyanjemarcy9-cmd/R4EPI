multi_means<-function(data){
#Create astructuretocontainresults
result <-vector("numeric", length(data))
#Iterate overeach columnofdata
for(i in seq_along(data)){
result[[i]]<-mean(data[[i]])
}
# Return the result
result
}
multi_means(df_xyz)
